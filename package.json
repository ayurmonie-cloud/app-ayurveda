{
  "name": "ayurmonie",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @ayurmonie/mobile start",
    "dev:admin": "pnpm --filter @ayurmonie/admin dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/supabase/src/database.types.ts && prettier --write packages/supabase/src/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "turbo": "^2.11.7"
  }
}

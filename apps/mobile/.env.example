# Copie ce fichier en .env.local et renseigne les valeurs de ton projet Supabase
# (Project Settings > API). La clé « publishable » peut être embarquée dans l'app :
# la sécurité repose sur la Row Level Security de la base.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
